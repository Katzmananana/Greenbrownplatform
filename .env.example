# Lab environment — never commit real secrets.
NODE_ENV=development
PORT=3000
GB_SERVICE_NAME=gateway

# Railway plugins (injected automatically on Railway)
DATABASE_URL=postgres://user:pass@localhost:5432/gb
REDIS_URL=redis://localhost:6379

# Gateway MCP bearer token. Required when NODE_ENV=production (else /mcp → 503).
# Unset in local/dev: any non-empty "Authorization: Bearer <x>" is accepted.
GB_MCP_TOKEN=
# Set to "memory" to ignore DATABASE_URL for the gateway run store.
GB_RUN_STORE=

# JWT (HS256) — generate a long random string for lab
GB_JWT_SIGNING_KEY=change-me

# Model / coding-agent keys (Railway Variables in lab/pilot)
# Spec names (preferred):
GB_XAI_API_KEY=
GB_ANTHROPIC_API_KEY=
GB_OPENAI_API_KEY=
GB_CURSOR_API_KEY=
GB_RAILWAY_TOKEN=

# Handoff aliases (same values may be copied into the GB_* vars)
GROK_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=

# §7 gate mode. GATE_STUB=1 (lab default) lets stub scripts pass.
# Set GATE_STUB=0 for fail-closed real mode (requires artifacts / tokens).
GATE_STUB=1
REVIEWER_TOKEN=
ACCEPTANCE_ARTIFACT_PATH=
REQUIREMENT_PATH=fixtures/requirement.md
STAGING_URL=
STAGING_HEALTH_PATH=/health
